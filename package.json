{
  "name": "haish-agent",
  "version": "0.0.17",
  "private": true,
  "description": "Haish desktop app with a local agent runtime.",
  "main": "dist-electron/main/main.js",
  "author": "Haish",
  "productName": "Haish",
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && tsc -p tsconfig.electron.json && concurrently -k -n web,electron -c cyan,magenta \"npm:dev:web\" \"electron .\"",
    "dev:web": "HAISH_DEV_WEB_WATCH=1 vite build --config vite.app-web.config.ts --watch",
    "dev:electron": "npm run build:web && tsc -p tsconfig.electron.json && electron .",
    "build:web": "vite build --config vite.app-web.config.ts",
    "build:web:release": "vite build --config vite.app-web.config.ts --mode release",
    "build": "npm run build:web && tsc --noEmit && tsc -p tsconfig.electron.json",
    "build:release": "npm run build:web:release && tsc --noEmit && tsc -p tsconfig.electron.json",
    "build:runtime": "node scripts/build-runtime.mjs",
    "start": "electron .",
    "pack:mac": "npm run build:release && npm run build:runtime && electron-builder --mac dir",
    "dist:mac": "npm run build:release && npm run build:runtime && electron-builder --mac dmg zip",
    "check:mac-release": "node scripts/check-mac-release.mjs",
    "dist:mac:release": "npm run check:mac-release && npm run build:release && npm run build:runtime && electron-builder --mac dmg zip --config.forceCodeSigning=true",
    "release:mac": "node scripts/release-mac.mjs",
    "release:mac:unsigned": "node scripts/release-mac.mjs --unsigned",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "node scripts/run-app-web-tests.mjs",
    "check:architecture": "node scripts/check-app-web-architecture.mjs",
    "check:web": "npm run check:architecture && npm test && npm run lint && npm run build:web",
    "lint": "eslint --max-warnings=0 \"app-web/src/**/*.{js,jsx}\" \"app-web/tests/**/*.{js,mjs}\"",
    "format": "prettier --write \"app-web/src/**/*.{js,jsx,css}\" \"src/**/*.{ts,tsx,css}\" \"*.md\"",
    "format:check": "prettier --check \"app-web/src/**/*.{js,jsx,css}\" \"src/**/*.{ts,tsx,css}\""
  },
  "build": {
    "appId": "com.haish.agent",
    "productName": "Haish",
    "artifactName": "Haish-${version}-${arch}.${ext}",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": "app-web/dist-release",
        "to": "app-web/dist",
        "filter": [
          "**/*"
        ]
      },
      "build/icon.png",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime/haish-agent-core",
        "to": "haish-agent-core",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/.idea/**",
          "!**/.pytest_cache/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/.env",
          "!**/.env.*",
          "!**/.env.local",
          "!**/*.key",
          "!**/*.p12",
          "!**/*.pfx"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "entitlements/entitlements.mac.plist",
      "entitlementsInherit": "entitlements/entitlements.mac.inherit.plist",
      "signIgnore": [
        "/Contents/Resources/haish-agent-core/.*\\.py$"
      ],
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "Haish-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "haishihua",
        "repo": "haish-agent",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@floating-ui/react": "^0.27.20",
    "@lexical/react": "^0.49.0",
    "@lobehub/icons-static-svg": "^1.66.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "@xyflow/react": "^12.11.2",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.1.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.7.0",
    "js-yaml": "^5.4.1",
    "lexical": "^0.49.0",
    "lucide-react": "^1.23.0",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "metal-fx": "^1.0.4",
    "metal-fx-text": "npm:metal-fx@2.0.10",
    "motion": "^13.2.0",
    "prettier": "^3.9.5",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "^0.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "@electron/osx-sign": {
      "isbinaryfile": "^5.0.7"
    }
  }
}
